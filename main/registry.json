[
  {
    "id": "aws-s3-checker",
    "version": "1.0.0",
    "author": "Jani Ärväs",
    "name": {
      "fi": "AWS S3 Tarkistin",
      "en": "AWS S3 Checker"
    },
    "description": {
      "fi": "Tarkistaa AWS S3 bucketin tilan.",
      "en": "Checks AWS S3 bucket status."
    },
    "category": {
      "fi": "ULKOPUOLISET PLUGINIT",
      "en": "OUT PLUGINS"
    },
    "type": "rest-api",
    "endpoint": "https://api.aws-tools.example/check",
    "inputs": [
      {
        "key": "bucketName",
        "type": "text",
        "label": {
          "fi": "Bucket nimi",
          "en": "Bucket Name"
        }
      }
    ]
  },
  { 
    "id": "owasp-zap-generic-api",
    "version": "1.1.0",
    "author": "Jani Ärväs",
    "name": {
      "fi": "OWASP ZAP Yleinen API",
      "en": "OWASP ZAP Generic API"
    },
    "description": {
      "fi": "Kutsu mitä tahansa OWASP ZAP:n JSON-rajapinnan metodia vapaasti.",
      "en": "Query any OWASP ZAP JSON API method freely."
    },
    "category": {
      "fi": "ULKOPUOLISET PLUGINIT",
      "en": "OUT PLUGINS"
    },
    "type": "rest-api",
    "endpoint": "http://localhost:8080/JSON/",
    "inputs": [
      {
        "key": "apiPath",
        "type": "text",
        "label": {
          "fi": "API Polku (esim. core/view/version tai spider/action/scan)",
          "en": "API Path (e.g., core/view/version or spider/action/scan)"
        },
        "placeholder": {
          "fi": "core/view/version",
          "en": "core/view/version"
        },
        "default": "core/view/version"
      },
      {
        "key": "url",
        "type": "text",
        "label": {
          "fi": "Kohde URL tai lisäparametri (tarvittaessa)",
          "en": "Target URL or extra parameter (if needed)"
        },
        "placeholder": {
          "fi": "http://example.com",
          "en": "http://example.com"
        }
      }
    ]
  },
  { 
    "id": "owasp-zap-openapi-import",
    "version": "1.0.1",
    "author": "Jani Ärväs",
    "name": {
      "fi": "OWASP ZAP OpenAPI Tuonti",
      "en": "OWASP ZAP OpenAPI Import"
    },
    "description": {
      "fi": "Tekee REST/openapi importin.",
      "en": "Fetches REST/openapi import."
    },
    "category": {
      "fi": "ULKOPUOLISET PLUGINIT",
      "en": "OUT PLUGINS"
    },
    "type": "rest-api",
    "endpoint": "http://localhost:8080/JSON/openapi/action/importUrl/",
    "inputs": [
      {
        "key": "url",
        "type": "text",
        "label": {
          "fi": "OpenAPI URL",
          "en": "OpenAPI URL"
        },
        "default": "https://petstore.swagger.io/v2/swagger.json"
      }
    ]
  },
  { 
    "id": "owasp-zap-critical-alerts",
    "version": "1.0.0",
    "author": "Jani Ärväs",
    "name": {
      "fi": "OWASP ZAP Kriittiset Hälytykset",
      "en": "OWASP ZAP Critical Alerts"
    },
    "description": {
      "fi": "Hakee ZAP-raportista kriittiset (High) haavoittuvuudet ja hälytykset.",
      "en": "Fetches critical (High) vulnerabilities and alerts from ZAP."
    },
    "category": {
      "fi": "ULKOPUOLISET PLUGINIT",
      "en": "OUT PLUGINS"
    },
    "type": "rest-api",
    "endpoint": "http://localhost:8080/JSON/core/view/alerts/",
    "inputs": []
  },
  {
    "id": "owasp-zap-all-alerts",
    "version": "1.0.0",
    "author": "Jani Ärväs",
    "name": {
      "fi": "OWASP ZAP Kaikki Hälytykset",
      "en": "OWASP ZAP All Alerts"
    },
    "description": {
      "fi": "Hakee kaikki löydetyt haavoittuvuudet ja hälytykset ZAPista.",
      "en": "Fetches all discovered vulnerabilities and alerts from ZAP."
    },
    "category": {
      "fi": "ULKOPUOLISET PLUGINIT",
      "en": "OUT PLUGINS"
    },
    "type": "rest-api",
    "endpoint": "http://localhost:8080/JSON/core/view/alerts/",
    "inputs": []
  },
  {
    "id": "zap-start-scan-fixed-v2",
    "name": { 
      "fi": "Käynnistä ZAP Skannaus Politiikalla", 
      "en": "Start ZAP Scan with Policy" 
    },
    "description": { 
      "fi": "Käynnistää aktiivisen skannauksen määritellyllä politiikalla.", 
      "en": "Starts active scan with a specified policy." 
    },
    "version": "2.1.0",
    "author": "Jani Ärväs",
    "category": {
      "fi": "ULKOPUOLISET PLUGINIT",
      "en": "OUT PLUGINS"
    },
    "type": "rest-api",
    "endpoint": "/zap-api/JSON/ascan/action/scan/",
    "inputs": [
      {
        "key": "url",
        "label": { "fi": "Kohde-URL", "en": "Target URL" },
        "type": "text",
        "default": "https://petstore3.swagger.io",
        "placeholder": { "fi": "https://...", "en": "https://..." }
      },
      {
        "key": "scanPolicyName",
        "label": { "fi": "Politiikan nimi", "en": "Policy Name" },
        "type": "text",
        "default": "Default Policy",
        "placeholder": { "fi": "Esim. Default Policy", "en": "E.g. Default Policy" }
      }
    ],
    "execute": "(inputs) => { return 'Skannaus käynnistetty'; }"
  },
  {
    "id": "zap-generate-html-report",
    "name": { 
      "fi": "Generoi ZAP HTML-raportti", 
      "en": "Generate ZAP HTML Report" 
    },
    "description": { 
      "fi": "Hakee tietoturvaskannauksen tulokset OWASP ZAP:lta ja muodostaa niistä HTML-raportin.", 
      "en": "Fetches security scan results from OWASP ZAP and generates an HTML report." 
    },
    "version": "1.0.0",
    "author": "Jani Ärväs",
    "category": {
      "fi": "ULKOPUOLISET PLUGINIT",
      "en": "OUT PLUGINS"
    },
    "type": "rest-api",
    "endpoint": "http://localhost:8080/OTHER/core/other/htmlreport/",
    "inputs": [
      {
        "key": "reportTitle",
        "label": { "fi": "Raportin otsikko", "en": "Report Title" },
        "type": "text",
        "default": "SwissKnife Security Audit Report"
      }
    ],
    "execute": "(inputs) => { return '<html><head><title>' + inputs.reportTitle + '</title></head><body><h1>Security Audit Report</h1><p>ZAP scan completed successfully.</p></body></html>'; }"
  }
]