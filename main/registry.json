{
    "id": "zap-generate-html-report",
    "name": { 
      "fi": "Generoi ZAP HTML-raportti", 
      "en": "Generate ZAP HTML Report" 
    },
    "description": { 
      "fi": "Hakee tietoturvaskannauksen tulokset OWASP ZAP:lta ja muodostaa niistä HTML-raportin.", 
      "en": "Fetches security scan results from OWASP ZAP and generates an HTML report." 
    },
    "version": "1.0.1",
    "author": "Jani Ärväs",
    "category": {
      "fi": "ULKOPUOLISET PLUGINIT",
      "en": "OUT PLUGINS"
    },
    "type": "local",
    "inputs": [
      {
        "key": "reportTitle",
        "label": { "fi": "Raportin otsikko", "en": "Report Title" },
        "type": "text",
        "default": "SwissKnife Security Audit Report"
      }
    ],
    "execute": "async (inputs) => { try { const res = await fetch('/zap-api/OTHER/core/other/htmlreport/'); const html = await res.text(); return { success: true, data: { message: 'HTML-raportti haettu onnistuneesti', length: html.length } }; } catch (e) { return { success: false, error: e.message }; } }"
  }
