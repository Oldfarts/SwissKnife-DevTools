[
  {
    "id": "utility-wait",
    "version": "1.0.0",
    "author": "Jani Ärväs",
    "name": {
      "fi": "Odotus / Viive",
      "en": "Wait / Delay"
    },
    "description": {
      "fi": "Pysäyttää työnkulun ketjun määrätyksi ajaksi (esim. ZAP-skannauksen välissä).",
      "en": "Pauses the workflow chain for a specified duration."
    },
    "category": {
      "fi": "ULKOPUOLISET PLUGINIT",
      "en": "OUT PLUGINS"
    },
    "type": "local",
    "inputs": [
      {
        "key": "seconds",
        "type": "text",
        "label": {
          "fi": "Odotusaika sekunteina",
          "en": "Wait time in seconds"
        },
        "default": "10",
        "placeholder": {
          "fi": "10",
          "en": "10"
        }
      }
    ],
      "execute": "async (inputs) => { const waitTimeSec = Number(inputs?.seconds ?? inputs?.inputContent ?? 10) || 10; await new Promise((resolve) => setTimeout(resolve, waitTimeSec * 1000)); return { success: true, data: inputs?.inputContent ?? 'Odotettu ' + waitTimeSec + ' sekuntia' }; }"  
  },
