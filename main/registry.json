  {
    "id": "zap-start-scan-fixed-v2",
    "version": "2.1.0",
    "author": "Jani Ärväs",
    "name": {
      "fi": "Käynnistä ZAP Skannaus Politiikalla",
      "en": "Start ZAP Scan with Policy"
    },
    "description": {
      "fi": "Käynnistää aktiivisen skannauksen.",
      "en": "Starts active scan."
    },
    "category": {
      "fi": "ULKOPUOLISET PLUGINIT",
      "en": "OUT PLUGINS"
    },
    "type": "rest-api",
    "endpoint": "/zap-api/JSON/ascan/action/scan/",
    "executionMode": "poll",
    "pollConfig": {
      "idField": "scan",
      "intervalMs": 100,
      "timeoutMs": 600000,
      "statusEndpoint": "/zap-api/JSON/ascan/view/status/",
      "statusParameter": "scanId",
      "statusField": "status",
      "finishedValue": "100",
      "resultEndpoint": "/zap-api/JSON/core/view/alerts/"
    },
    "inputs": [
      {
        "key": "url",
        "label": {
          "fi": "Kohde URL",
          "en": "Target URL"
        },
        "type": "text",
        "default": "http://localhost:5173/mini-api.json"
      },
      {
        "key": "scanPolicyName",
        "label": {
          "fi": "Politiikan nimi",
          "en": "Policy Name"
        },
        "type": "text",
        "default": "Default Policy"
      }
    ]
  },
  {
    "id": "zap-generate-html-report",
    "name": { 
      "fi": "Generoi ZAP HTML-raportti", 
      "en": "Generate ZAP HTML Report" 
    },
    "description": { 
      "fi": "Hakee tietoturvaskannauksen tulokset OWASP ZAP:lta ja muodostaa niistä HTML-raportin.", 
      "en": "Fetches security scan results from OWASP ZAP and generates an HTML report." 
    },
    "version": "1.0.1",
    "author": "Jani Ärväs",
    "category": {
      "fi": "ULKOPUOLISET PLUGINIT",
      "en": "OUT PLUGINS"
    },
    "type": "local",
    "inputs": [
      {
        "key": "reportTitle",
        "label": { "fi": "Raportin otsikko", "en": "Report Title" },
        "type": "text",
        "default": "SwissKnife Security Audit Report"
      }
    ],
    "execute": "async (inputs) => { try { const res = await fetch('/zap-api/OTHER/core/other/htmlreport/'); const html = await res.text(); const blob = new Blob([html], { type: 'text/html' }); const url = window.URL.createObjectURL(blob); const a = document.createElement('a'); a.href = url; a.download = 'zap-security-report.html'; document.body.appendChild(a); a.click(); window.URL.revokeObjectURL(url); document.body.removeChild(a); return { success: true, data: { message: 'HTML-raportti haettu ja tallennettu tiedostona onnistuneesti', length: html.length } }; } catch (e) { return { success: false, error: e.message }; } }"
  },
  {
    "id": "image-exif-reader",
    "version": "1.1.0",
    "author": "Jani Ärväs",
    "name": {
      "fi": "Kuvien EXIF Lukija",
      "en": "Image EXIF Reader"
    },
    "description": {
      "fi": "Lukee ja näyttää kuvatiedoston (JPG/PNG) EXIF-metatiedot suoraan selaimessa.",
      "en": "Reads and displays EXIF metadata from an image file directly in the browser."
    },
    "category": {
      "fi": "ULKOPUOLISET PLUGINIT",
      "en": "OUT PLUGINS"
    },
    "type": "local",
    "inputs": [
      {
        "key": "imageFile",
        "type": "file",
        "label": {
          "fi": "Valitse kuvatiedosto työpöydältä",
          "en": "Select image file"
        }
      }
    ],
    "execute": "async (inputs) => { const file = inputs.imageFile; if (!file) { return { success: false, error: 'Tiedostoa ei valittu.' }; } return { success: true, data: { name: file.name, size: file.size, type: file.type, lastModified: new Date(file.lastModified).toLocaleString(), message: 'Kuva vastaanotettu onnistuneesti selaimessa.' } }; }"
  }
]